{
  "name": "venture-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web 'tsx watch apps/api/src/server.ts' 'tsx watch apps/worker/src/worker.ts' 'vite --host 127.0.0.1'",
    "start": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/worker/src/worker.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/feedback.test.ts tests/comparison.test.ts tests/topic.test.ts tests/localization.test.ts tests/data-engine.test.ts tests/x-browser.test.ts tests/radar-evidence.test.ts tests/tool-search.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db.test.ts tests/api.test.ts tests/translation.test.ts tests/opportunities.test.ts tests/research.test.ts tests/radar.test.ts tests/reddit-browser.test.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:local": "bash scripts/local-db.sh",
    "smoke": "tsx scripts/smoke.ts",
    "test:python": "PYTHONPATH=services/data-engine .local/python-venv/bin/python -m unittest discover -s services/data-engine/tests -v",
    "test:browser-reader": "node --test tests/reddit-reader.test.mjs tests/x-reader.test.mjs",
    "test:extension": "tsx --test tests/reddit-extension.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
